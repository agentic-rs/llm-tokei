---
import ModelsNav from "../../components/ModelsNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Model data | llm-tokei";
const pageDescription =
  "Explore historical LLM prices and model family mappings derived from models.dev.";
const modelsUrl = `${import.meta.env.BASE_URL}models/`;
const tools = [
  {
    eyebrow: "Price history",
    title: "Compare prices over time.",
    copy: "Plot input, output, cache, audio, and reasoning prices across provider routes. Every point links back to its source revision.",
    href: `${modelsUrl}prices/`,
    action: "Open price explorer"
  },
  {
    eyebrow: "Model families",
    title: "Resolve route names.",
    copy: "Search current and removed provider routes for their canonical model name, family, and known release date.",
    href: `${modelsUrl}families/`,
    action: "Browse family mapping"
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container models-page">
    <ModelsNav current="overview" />

    <header class="models-hero">
      <span class="eyebrow">Models data</span>
      <h1>Names and prices, with history.</h1>
      <p>
        A public, traceable dataset built from
        <a href="https://github.com/anomalyco/models.dev">models.dev</a>
        and llm-tokei’s model catalog. Explore it here or consume the CSV files
        directly.
      </p>
    </header>

    <section class="tool-grid" aria-label="Model data tools">
      {
        tools.map((tool, index) => (
          <article class:list={["tool-card", "panel", `tool-card--${index + 1}`]}>
            <span class="eyebrow">{tool.eyebrow}</span>
            <h2>{tool.title}</h2>
            <p>{tool.copy}</p>
            <a class="tool-card__link" href={tool.href}>
              {tool.action} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </section>

    <section class="data-section" aria-labelledby="data-title">
      <div>
        <span class="eyebrow">Direct data</span>
        <h2 id="data-title">Stable URLs for scripts.</h2>
      </div>
      <div class="endpoint-list panel">
        <a href={`${modelsUrl}changes.csv`}>
          <code>models/changes.csv</code>
          <span>Historical provider-route price changes</span>
        </a>
        <a href={`${modelsUrl}families.csv`}>
          <code>models/families.csv</code>
          <span>Provider model, canonical name, family, and release date</span>
        </a>
        <a href={`${modelsUrl}manifest.json`}>
          <code>models/manifest.json</code>
          <span>Checksums, immutable filenames, and source provenance</span>
        </a>
      </div>
      <p class="data-note">
        Stable URLs are revalidated by GitHub Pages. For reproducible inputs,
        use the content-addressed filenames recorded in the manifest.
      </p>
    </section>
  </div>

  <style>
    .models-page {
      display: grid;
      gap: clamp(3rem, 7vw, 5rem);
    }

    .models-hero {
      display: grid;
      max-width: 68rem;
      gap: 1.35rem;
      padding: clamp(1rem, 4vw, 3rem) 0;
    }

    .models-hero h1 {
      margin: 0;
      max-width: 12ch;
      font-size: clamp(3.4rem, 9vw, 7.5rem);
      line-height: 0.88;
      letter-spacing: -0.055em;
    }

    .models-hero p {
      max-width: 45rem;
      margin: 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 2vw, 1.2rem);
    }

    .models-hero a,
    .data-note a {
      color: var(--green-deep);
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    .tool-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1rem, 3vw, 2rem);
    }

    .tool-card {
      display: grid;
      min-height: 23rem;
      align-content: start;
      gap: 1.2rem;
      padding: clamp(1.5rem, 4vw, 2.5rem);
      box-shadow: 8px 8px 0 var(--paper-deep);
    }

    .tool-card--2 {
      background: rgba(238, 245, 241, 0.92);
    }

    .tool-card h2 {
      max-width: 11ch;
      margin: auto 0 0;
      padding-top: 3rem;
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 0.95;
    }

    .tool-card p {
      max-width: 35rem;
      margin: 0;
      color: var(--ink-soft);
    }

    .tool-card__link {
      display: inline-flex;
      width: fit-content;
      gap: 0.55rem;
      align-items: center;
      margin-top: 0.5rem;
      color: var(--green-deep);
      font-weight: 800;
    }

    .tool-card__link:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .data-section {
      display: grid;
      grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
      gap: 1.5rem clamp(2rem, 6vw, 5rem);
      align-items: start;
    }

    .data-section h2 {
      max-width: 10ch;
      margin: 0.8rem 0 0;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 0.96;
    }

    .endpoint-list {
      overflow: hidden;
    }

    .endpoint-list a {
      display: grid;
      grid-template-columns: minmax(13rem, 0.65fr) minmax(0, 1fr);
      gap: 1rem;
      padding: 1.15rem 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .endpoint-list a:last-child {
      border-bottom: 0;
    }

    .endpoint-list a:hover {
      background: var(--panel-cool);
    }

    .endpoint-list code {
      color: var(--green-deep);
      font-weight: 700;
    }

    .endpoint-list span {
      color: var(--ink-soft);
    }

    .data-note {
      grid-column: 2;
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.9rem;
    }

    @media (max-width: 760px) {
      .tool-grid,
      .data-section {
        grid-template-columns: 1fr;
      }

      .tool-card {
        min-height: 20rem;
      }

      .data-note {
        grid-column: 1;
      }

      .endpoint-list a {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }
    }
  </style>
</BaseLayout>
