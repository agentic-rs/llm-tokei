---
const destination = `${import.meta.env.BASE_URL}models/prices/`;
const canonical = new URL(destination, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={canonical.toString()} />
    <title>Moving to model prices…</title>
  </head>
  <body>
    <p>
      Price history moved to <a href={destination}>the models section</a>.
    </p>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(
        `${destination}${window.location.search}${window.location.hash}`,
      );
    </script>
  </body>
</html>
