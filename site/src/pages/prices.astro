---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "LLM price history | llm-tokei";
const pageDescription =
  "Explore provider-route token prices recorded in the models.dev Git history.";
const dataBaseUrl = `${import.meta.env.BASE_URL}price-history/`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container prices-page" data-price-app data-data-base-url={dataBaseUrl}>
    <header class="prices-hero">
      <div>
        <span class="eyebrow">Price history</span>
        <h1>What did a token cost?</h1>
      </div>
      <div class="prices-hero__copy">
        <p>
          Compare the provider-route prices recorded in the
          <a href="https://github.com/anomalyco/models.dev">models.dev</a>
          Git history. Values are USD per million tokens.
        </p>
        <p class="prices-hero__note">
          Dates show when models.dev recorded a change, which may differ from a
          provider’s actual effective date.
        </p>
      </div>
    </header>

    <section class="explorer panel" aria-labelledby="explorer-title">
      <div class="explorer__header">
        <div>
          <span class="eyebrow">Explorer</span>
          <h2 id="explorer-title">Provider-route pricing</h2>
        </div>
        <p class="status" data-status aria-live="polite">Loading price history…</p>
      </div>

      <div class="controls" data-controls hidden>
        <label>
          <span>Provider</span>
          <select data-provider aria-label="Provider"></select>
        </label>
        <div class="model-control">
          <label>
            <span>Model routes · up to 5</span>
            <span class="model-picker">
              <input
                data-model
                list="price-models"
                type="text"
                autocomplete="off"
                aria-label="Model route to compare"
                placeholder="Choose another model"
              />
              <button data-add-model type="button">Add</button>
            </span>
            <datalist id="price-models" data-model-list></datalist>
          </label>
          <div
            class="selected-models"
            data-selected-models
            aria-label="Selected model routes"
          ></div>
        </div>
        <fieldset data-fields>
          <legend>Price dimensions</legend>
        </fieldset>
      </div>

      <div class="chart-shell" data-chart-shell hidden>
        <div class="chart-heading">
          <div>
            <p class="chart-route mono" data-route></p>
            <p class="chart-range" data-range></p>
          </div>
          <div class="legend" data-legend aria-label="Chart legend"></div>
        </div>
        <div class="metric-charts" data-charts></div>
        <div class="chart-footer">
          <p data-summary></p>
          <p>
            Filled dots start a price, rings mark changes, and × marks removal.
            Panels share time, use independent scales, and show missing values
            as gaps.
          </p>
        </div>
      </div>

      <div class="empty-state" data-empty hidden>
        <strong data-empty-title>Price history is not available in this build.</strong>
        <span data-empty-detail>
          The scheduled Pages build generates it without committing the CSV to Git.
        </span>
      </div>
    </section>

    <section class="provenance" aria-labelledby="provenance-title">
      <div>
        <span class="eyebrow">Provenance</span>
        <h2 id="provenance-title">Traceable to source.</h2>
      </div>
      <dl class="provenance__facts panel">
        <div>
          <dt>Source commit</dt>
          <dd><a data-source-commit href="https://github.com/anomalyco/models.dev">—</a></dd>
        </div>
        <div>
          <dt>History events</dt>
          <dd data-event-count>—</dd>
        </div>
        <div>
          <dt>Provider routes</dt>
          <dd data-route-count>—</dd>
        </div>
        <div>
          <dt>Download size</dt>
          <dd data-download-size>—</dd>
        </div>
      </dl>
    </section>
  </div>

  <style>
    .prices-page {
      display: grid;
      gap: clamp(3rem, 7vw, 5rem);
    }

    .prices-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: end;
      padding-top: clamp(0.5rem, 3vw, 2rem);
    }

    .prices-hero > div:first-child {
      display: grid;
      gap: 1.2rem;
    }

    .prices-hero h1 {
      margin: 0;
      max-width: 10ch;
      font-size: clamp(3.2rem, 9vw, 7rem);
      line-height: 0.9;
      letter-spacing: -0.05em;
    }

    .prices-hero__copy {
      display: grid;
      gap: 1rem;
      padding-bottom: 0.4rem;
    }

    .prices-hero__copy p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 1.05rem;
    }

    .prices-hero__copy a {
      color: var(--green-deep);
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    .prices-hero__note {
      padding-left: 1rem;
      border-left: 3px solid var(--amber);
      font-size: 0.92rem !important;
    }

    .explorer {
      min-width: 0;
      overflow: hidden;
      background: rgba(255, 250, 240, 0.94);
      box-shadow: 10px 10px 0 var(--paper-deep);
    }

    .explorer__header {
      display: flex;
      justify-content: space-between;
      gap: 2rem;
      align-items: end;
      padding: clamp(1rem, 3vw, 1.5rem);
      border-bottom: 1px solid var(--line);
    }

    .explorer__header > div {
      display: grid;
      gap: 0.55rem;
    }

    .explorer h2,
    .provenance h2 {
      margin: 0;
      font-size: clamp(1.8rem, 4vw, 3.5rem);
      line-height: 1;
    }

    .status {
      margin: 0;
      color: var(--ink-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-align: right;
    }

    .controls {
      display: grid;
      grid-template-columns: minmax(10rem, 0.55fr) minmax(19rem, 1.25fr) minmax(20rem, 1.4fr);
      gap: 1rem;
      padding: 1rem clamp(1rem, 3vw, 1.5rem);
      border-bottom: 1px solid var(--line);
      background: var(--panel-cool);
    }

    .controls label,
    .controls fieldset,
    .model-control {
      display: grid;
      min-width: 0;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .controls label > span:first-child,
    .controls legend {
      color: var(--ink-muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .controls select,
    .controls input {
      width: 100%;
      min-width: 0;
      height: 2.75rem;
      padding: 0 0.75rem;
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      color: var(--ink);
      background: var(--panel);
      font: 0.9rem var(--font-mono);
    }

    .model-picker {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .model-picker input {
      border-radius: 6px 0 0 6px;
    }

    .model-picker button {
      min-width: 3.8rem;
      border: 1px solid var(--ink);
      border-left: 0;
      border-radius: 0 6px 6px 0;
      color: var(--panel);
      background: var(--ink);
      font: 800 0.76rem var(--font-mono);
      cursor: pointer;
    }

    .model-picker button:hover {
      background: var(--green-deep);
    }

    .selected-models {
      display: flex;
      min-height: 1.7rem;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    :global(.model-chip) {
      display: inline-flex;
      min-width: 0;
      align-items: center;
      gap: 0.35rem;
      padding: 0.22rem 0.25rem 0.22rem 0.45rem;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--panel);
      font: 0.72rem var(--font-mono);
    }

    :global(.model-chip__swatch) {
      width: 0.58rem;
      height: 0.58rem;
      flex: 0 0 auto;
      border-radius: 50%;
      background: var(--model-color);
    }

    :global(.model-chip__label) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(.model-chip__remove) {
      display: grid;
      width: 1.25rem;
      height: 1.25rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      place-items: center;
      color: var(--ink-muted);
      background: transparent;
      font: 1rem/1 var(--font-sans);
      cursor: pointer;
    }

    :global(.model-chip__remove:hover:not(:disabled)) {
      color: var(--panel);
      background: var(--model-color);
    }

    :global(.model-chip__remove:disabled) {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .controls fieldset {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-content: end;
      gap: 0.35rem 0.75rem;
    }

    .controls legend {
      grid-column: 1 / -1;
      margin-bottom: 0.4rem;
    }

    :global(.field-toggle) {
      display: flex !important;
      grid-template-columns: none !important;
      align-items: center;
      gap: 0.4rem !important;
      color: var(--ink-soft);
      font-size: 0.8rem;
      white-space: nowrap;
    }

    :global(.field-toggle input) {
      width: 0.95rem;
      height: 0.95rem;
      margin: 0;
      accent-color: var(--green);
    }

    :global(.field-toggle[data-unavailable="true"]) {
      opacity: 0.42;
    }

    .chart-shell {
      padding: clamp(1rem, 3vw, 1.5rem);
    }

    .chart-heading,
    .chart-footer {
      display: flex;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .chart-heading {
      min-height: 4.5rem;
      align-items: start;
    }

    .chart-route {
      margin: 0;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .chart-range {
      margin: 0.2rem 0 0;
      color: var(--ink-muted);
      font-size: 0.85rem;
    }

    .legend {
      display: flex;
      max-width: 55%;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem 0.85rem;
    }

    :global(.legend__item) {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      font: 0.76rem var(--font-mono);
    }

    :global(.legend__swatch) {
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 2px;
      background: var(--legend-color);
    }

    .metric-charts {
      display: grid;
      gap: 1rem;
    }

    :global(.metric-chart) {
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: rgba(255, 255, 255, 0.3);
    }

    :global(.metric-chart__heading) {
      display: flex;
      min-height: 3.4rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.7rem 0.9rem;
      border-bottom: 1px solid var(--line);
      background: var(--panel-cool);
    }

    :global(.metric-chart__heading > div) {
      display: flex;
      flex: 0 0 auto;
      align-items: baseline;
      gap: 0.55rem;
    }

    :global(.metric-chart__heading h3) {
      margin: 0;
      font-size: 1rem;
    }

    :global(.metric-chart__heading span),
    :global(.metric-chart__detail) {
      color: var(--ink-muted);
      font: 0.7rem/1.45 var(--font-mono);
    }

    :global(.metric-chart__detail) {
      margin: 0;
      text-align: right;
    }

    :global(.metric-chart__detail a) {
      color: var(--blue);
      font-weight: 800;
    }

    :global(.metric-chart__plot) {
      min-width: 0;
      overflow: hidden;
    }

    :global(.metric-chart__plot .uplot) {
      font-family: var(--font-mono);
    }

    :global(.metric-chart__plot .u-cursor-x) {
      border-right: 1px dashed var(--ink-muted);
    }

    :global(.change-marker) {
      position: absolute;
      z-index: 4;
      width: 0.68rem;
      height: 0.68rem;
      padding: 0;
      border: 2px solid var(--marker-color);
      border-radius: 50%;
      color: var(--marker-color);
      background: var(--panel);
      box-shadow: 0 0 0 2px rgba(255, 250, 240, 0.75);
      transform: translate(-50%, -50%);
      cursor: help;
    }

    :global(.change-marker--start) {
      background: var(--marker-color);
    }

    :global(.change-marker--remove) {
      display: grid;
      width: 0.9rem;
      height: 0.9rem;
      border: 0;
      border-radius: 0;
      place-items: center;
      background: var(--panel);
      box-shadow: none;
      font: 900 1rem/0.9 var(--font-sans);
    }

    :global(.change-marker:focus-visible) {
      outline: 3px solid var(--amber);
      outline-offset: 2px;
    }

    :global(.chart-empty) {
      display: grid;
      min-height: 16rem;
      margin: 0;
      place-items: center;
      color: var(--ink-muted);
      font: 0.85rem var(--font-mono);
    }

    .chart-footer {
      padding-top: 0.85rem;
      border-top: 1px solid var(--line);
      color: var(--ink-muted);
      font-size: 0.78rem;
    }

    .chart-footer p {
      margin: 0;
    }

    .empty-state {
      display: grid;
      gap: 0.4rem;
      padding: clamp(2rem, 7vw, 5rem) 1.5rem;
      text-align: center;
    }

    .empty-state span {
      color: var(--ink-muted);
    }

    .provenance {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 2rem;
      align-items: start;
    }

    .provenance > div {
      display: grid;
      gap: 0.8rem;
    }

    .provenance__facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      overflow: hidden;
    }

    .provenance__facts div {
      display: grid;
      gap: 0.35rem;
      padding: 1rem;
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }

    .provenance__facts div:nth-child(-n + 2) {
      border-top: 0;
    }

    .provenance__facts div:nth-child(odd) {
      border-left: 0;
    }

    .provenance__facts dt {
      color: var(--ink-muted);
      font: 0.72rem var(--font-mono);
      text-transform: uppercase;
    }

    .provenance__facts dd {
      min-width: 0;
      margin: 0;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .provenance__facts a {
      color: var(--blue);
    }

    @media (max-width: 900px) {
      .prices-hero,
      .provenance {
        grid-template-columns: 1fr;
      }

      .prices-hero__copy {
        max-width: 45rem;
      }

      .controls {
        grid-template-columns: 1fr 1.5fr;
      }

      .controls fieldset {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 620px) {
      .explorer {
        box-shadow: 5px 5px 0 var(--paper-deep);
      }

      .explorer__header,
      .chart-heading,
      .chart-footer {
        align-items: flex-start;
        flex-direction: column;
      }

      .status {
        text-align: left;
      }

      .controls {
        grid-template-columns: 1fr;
      }

      .controls fieldset {
        grid-column: auto;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .legend {
        max-width: none;
        justify-content: flex-start;
      }

      :global(.metric-chart__heading) {
        align-items: flex-start;
        flex-direction: column;
      }

      :global(.metric-chart__detail) {
        text-align: left;
      }

      .provenance__facts {
        grid-template-columns: 1fr;
      }

      .provenance__facts div,
      .provenance__facts div:nth-child(-n + 2) {
        border-top: 1px solid var(--line);
        border-left: 0;
      }

      .provenance__facts div:first-child {
        border-top: 0;
      }
    }
  </style>

  <script>
    import "../scripts/price-history";
  </script>
</BaseLayout>
